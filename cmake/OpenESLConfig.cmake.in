@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(dependencies "@OPENESL_DEPENDENCIES@")
foreach(depend ${dependencies})
  if(NOT depend STREQUAL "")
    find_dependency(${depend})
  endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/OpenESLTargets.cmake")

check_required_components(OpenESL)
